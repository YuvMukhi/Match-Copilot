# Match Copilot Environment Variables

# Application
APP_NAME="Match Copilot"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./match_copilot.db

# LLM Configuration
# Set USE_MOCK_LLM=true to run offline with deterministic mock responses
USE_MOCK_LLM=true
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Scoring rules configuration path
SCORING_RULES_PATH=./backend/scoring_rules.yaml
